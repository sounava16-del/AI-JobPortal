PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Leave empty to use automatic embedded MongoDB for local testing, or provide your Atlas URI)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_job_portal?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secrets
JWT_SECRET=super_secret_jwt_key_ai_job_portal_2026_dev_secure
JWT_EXPIRES_IN=7d

# AI Configuration (Groq or OpenAI)
# Provide GROQ_API_KEY or OPENAI_API_KEY (optional, smart heuristic AI fallback included)
GROQ_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b

# Storage Configuration ('local' or 's3')
STORAGE_TYPE=local
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# Email / 2FA Configuration (Optional - dev mode logs OTP to console and returns in response)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@aijobportal.com
